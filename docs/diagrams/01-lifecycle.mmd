%% 01 药品全生命周期总览（泳道）——全角色一张看全，后期段虚线+橙色标注
flowchart LR
  subgraph SUP["供应商"]
    S1["实物发货<br/>每件带 20 位追溯码"]
  end

  subgraph PUR["采购"]
    P1["采购到货登记"]
    P2["扫码入库<br/>码 → 药解析"]
    P3{"标识码<br/>解析命中？"}
    P4["异常码人工补录<br/>（bad-codes）"]
  end

  subgraph WH["库房"]
    W1["在架库存<br/>存码 · 按药统计"]
    W2["领用备货出库<br/>申请(药) ⇄ 备货(码)"]
    W3["退回 / 损耗 /<br/>其他出入库"]
  end

  subgraph PH["药房"]
    H1["药房入库确认<br/>在途清零"]
    H2["入槽绑定<br/>取药柜·取药槽"]
    H3["货位存放<br/>（不入槽也能出）"]
    H4["调剂 · 出库扫码"]
  end

  subgraph MD["医生 / 病房（后期）"]
    M1["医生开处方<br/>药名 + 数量"]
    M2["病房 / 患者"]
  end

  S1 --> P1 --> P2 --> P3
  P3 -->|"命中：建档+批次+效期"| W1
  P3 -.->|"未命中：拦截"| P4 -.->|"补录后重扫"| W1
  W1 --> W2 -->|"审核扣账 → 在途"| H1
  W1 <--> W3
  H1 -.-> H2
  H1 -.-> H3
  H2 -.-> H4
  H3 -.-> H4
  M1 -.->|"处方驱动"| H4
  H4 -.-> M2

  classDef future fill:#fff7e6,stroke:#d48806,stroke-dasharray:5 5,color:#874d00;
  class H2,H3,H4,M1,M2 future;
