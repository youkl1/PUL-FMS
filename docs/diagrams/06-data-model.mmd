%% 06 数据模型 ER（字段级）——四组业务表 + 组织架构；库存的真实载体是 TRACE_CODE 追溯码实例
erDiagram
  DRUGS ||--o{ IDCODES : "1 药多码"
  IDCODES ||--o{ TRACE_CODE : "前 7 位派生实例"
  DOC ||--o{ DOC_CODE : "单据含码清单"
  TRACE_CODE ||--o{ DOC_CODE : "码随单据流转"
  CAMPUS ||--o{ WAREHOUSE : "下辖"
  CAMPUS ||--o{ PHARMACY : "下辖"
  WAREHOUSE ||--o{ WH_LOCATION : "库位"
  PHARMACY ||--o{ PH_LOCATION : "货位"
  PHARMACY ||--o{ CABINET : "取药柜（本期仅字典）"
  CABINET ||--o{ CAB_LAYER : "摆药层"
  CAB_LAYER ||--o{ CAB_CELL : "取药槽（绑定后期再议）"
  PHARMACY ||--o{ BASE_STATION : "基站（本期仅字典）"
  BASE_STATION ||--o{ LIGHT_GROUP : "灯组（扫码新增）"

  DRUGS {
    string drugCode PK "药品编码 YPxxxxxx"
    string drugName "通用名"
    string formSpec "制剂规格"
    string maker "厂家"
    string approval "批准文号"
    string category "分类"
    string baseUnit "库存基本单位（换算链尾）"
    json units "换算链 [{u:箱,eq:60},{u:瓶,eq:1}]"
    json minUnit "拆零最小单位 {u:片,per:7}"
    string warehouse "所属库房（按库房分别建档）"
    string status "待审核/启用/停用"
  }
  IDCODES {
    string idcode PK "7 位产品资源码"
    string drugCode FK "→ 药品主表"
    int level "码等级 1最小/2中/3大包装"
    string packSpec "包装规格 箱60瓶"
    string packUnit "包装单位（从规格解析）"
    string status "停用=扫码按异常码拦截"
  }
  TRACE_CODE {
    string code PK "20 位=7标识+9序列+4校验"
    string batch "批次"
    date expDate "效期（FEFO 依据）"
    string location "库位/货位"
  }
  DOC {
    string billNo PK "单号"
    string type "采购入/采购退/领用/退回入/其他入/其他出/损耗"
    string status "建单→已审核→终态"
    string warehouse "所属库房"
    string operator "操作人"
    date date "单据日期"
  }
  DOC_CODE {
    string billNo FK
    string code FK "20 位追溯码"
  }
  CAMPUS {
    string code PK "院区"
  }
  WAREHOUSE {
    string code PK
    string campus FK "挂院区"
  }
  WH_LOCATION {
    string code PK "库位"
  }
  PHARMACY {
    string code PK
    string campus FK "挂院区"
  }
  PH_LOCATION {
    string code PK "货位"
  }
  CABINET {
    string code PK "取药柜（挂药房）"
  }
  CAB_LAYER {
    string code PK "摆药层"
  }
  CAB_CELL {
    string code PK "取药槽 层-槽"
  }
  BASE_STATION {
    string code PK "基站（挂药房）"
  }
  LIGHT_GROUP {
    string addr PK "地址码（扫码登记）"
  }
