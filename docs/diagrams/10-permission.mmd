%% 10 权限模型 + 登录上下文——功能权限归角色，行数据归登录上下文自动隔离
flowchart TB
  subgraph LOGIN["登录四段式"]
    L1["① 账号密码"]
    L2{"② 是否超管？"}
    L3["超管：手动选院区"]
    L4["非超管：自动进唯一院区"]
    L5{"③ 是否双栖用户？<br/>（同时授权库房+药房）"}
    L6["选模式大卡：<br/>库房管理 / 药房管理"]
    L7["④ 选具体库房/药房<br/>（唯一授权则直达）"]
    L1 --> L2
    L2 -->|是| L3 --> L5
    L2 -->|否| L4 --> L5
    L5 -->|是| L6 --> L7
    L5 -->|否| L7
  end

  subgraph MODEL["权限叠加口径"]
    M1["功能权限 = 角色<br/>（菜单树勾选）"]
    M2["行数据 = 登录上下文<br/>（院区/库房/药房自动隔离）<br/>→ 再按本人隔离"]
    M3["超级用户（系统管理员）<br/>不指定院区 · 不可禁用 · 不参与业务"]
  end

  subgraph ORG["授权来源（用户管理）"]
    O1["所属院区<br/>（非超管必填唯一）"]
    O2["授权库房/药房多选<br/>（决定登录候选）"]
  end

  L7 ==> CTX(["登录上下文<br/>模式/院区/库房/药房"])
  O1 --> L4
  O2 --> L5
  O2 --> L7
  CTX --> M2
  M1 --> CTX

  classDef ctx fill:#e6f4ff,stroke:#206bc4;
  class CTX ctx;
