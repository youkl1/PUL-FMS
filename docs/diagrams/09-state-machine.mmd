%% 09 状态机（双轨）——追溯码实例状态 × 单据状态；「入槽」是可选状态而非必经状态
flowchart LR
  subgraph CODE["追溯码实例状态轨"]
    C1["已入库 · 在架"]
    C2["在途<br/>（领用出库已审核）"]
    C3["药房库存"]
    C4["入槽<br/>【可选状态】"]
    C5["已发药 · 终态"]
    C6["已退供应商 · 终态"]
    C7["已损耗销毁 · 终态<br/>（不可恢复）"]
    C8["退回库房途中"]

    C1 -->|"领用出库审核"| C2
    C2 -->|"药房确认入库"| C3
    C3 -.->|"绑定取药槽（可跳过）"| C4
    C3 -->|"出库扫码（不入槽路径）"| C5
    C4 -.->|"出库扫码"| C5
    C1 -->|"采购退货审核"| C6
    C1 -->|"损耗报损重确认"| C7
    C3 -->|"损耗"| C7
    C3 -->|"退回库房"| C8
    C8 -->|"退回入库审核"| C1
  end

  subgraph DOC["单据状态轨（7 类单据同构）"]
    D1["建单 · 草稿"]
    D2["已审核 · 生效<br/>（进入库存集合推导）"]
    D3["终态 · 不可改"]

    D1 -->|"审核"| D2
    D1 -->|"作废"| D3
    D2 -->|"闭环/销毁"| D3
  end

  classDef terminal fill:#f6f8fb,stroke:#626976;
  classDef optional fill:#fff7e6,stroke:#d48806,stroke-dasharray:5 5;
  class C5,C6,C7,D3 terminal;
  class C4 optional;
