%% 05 人工后台维护入口总览——每个入口标注「补的是哪张表」，系统的兜底能力
flowchart LR
  subgraph ENTRY["人工维护入口"]
    E1["手工建档<br/>（药品字典）"]
    E2["HIS 导入<br/>（药品字典）"]
    E3["异常码补录<br/>（bad-codes 台账）"]
    E4["标识码停用/启用<br/>（标识码字典）"]
    E5["其他入库 / 其他出库<br/>（库存调整）"]
    E6["损耗报损<br/>（损耗出库单）"]
  end

  subgraph TABLE["补写的表"]
    T1[("DRUGS 药品主表<br/>换算链/基本单位/拆零")]
    T2[("IDCODES 标识码子表<br/>7位码→药品/等级/包装单位")]
    T3[("单据 + 码清单<br/>库存集合推导的事实源")]
  end

  E1 -->|"新增默认「待审核」<br/>无标识码拦截审核"| T1
  E1 --> T2
  E2 -->|"按编码匹配：新增建档待审核<br/>已有幂等更新，可重复导入"| T1
  E3 -->|"upsert：有码更新/无码新建<br/>主表缺则一并建"| T2
  E3 --> T1
  E4 -->|"停用 = 扫码按异常码拦截"| T2
  E5 -->|"审核后进入库存加减集合"| T3
  E6 -->|"重确认「已销毁终态不可恢复」"| T3

  classDef entry fill:#e6f4ff,stroke:#206bc4;
  classDef tbl fill:#f6f8fb,stroke:#626976;
  class E1,E2,E3,E4,E5,E6 entry;
  class T1,T2,T3 tbl;
