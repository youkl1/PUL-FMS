%% 08 库存推导示意图——在架不加 status 字段，由 7 类已审核单据集合加减推导
flowchart TB
  subgraph PLUS["加集合（已审核生效）"]
    A1["采购入库单 ✓"]
    A2["其他入库单 ✓"]
    A3["退回入库单 ✓"]
  end

  subgraph MINUS["减集合（已审核生效）"]
    M1["采购退货单 ✓"]
    M2["领用出库单"]
    M3["其他出库单 ✓"]
    M4["损耗出库单 ✓"]
  end

  STOCK[("在架库存<br/>= Σ加 − Σ减<br/>逐码带批次/效期/库位")]
  TRANSIT[("在途<br/>= 领用出库单 status=已出库<br/>的码单列")]
  PHSTOCK[("药房库存<br/>= 确认药房入库的码")]
  LOCK[("处方锁定量<br/>【待决，见图 04】")]

  A1 --> STOCK
  A2 --> STOCK
  A3 --> STOCK
  M1 --> STOCK
  M2 --> STOCK
  M3 --> STOCK
  M4 --> STOCK
  M2 -->|"审核出库即扣账"| TRANSIT
  TRANSIT -->|"确认药房入库"| PHSTOCK
  LOCK -.->|"待决：是否预占"| STOCK

  NOTE["<b>为什么不加 status 字段</b><br/>状态由单据集合推导，单一事实源在单据；<br/>加 status 等于双写，审核漏单即不一致。<br/>统计口径：库存按码存，展示按药品基本单位折（换算链）"]
  STOCK -.-> NOTE

  classDef store fill:#f6f8fb,stroke:#626976;
  classDef note fill:#fff7e6,stroke:#d48806,color:#874d00;
  class STOCK,TRANSIT,PHSTOCK store;
  class NOTE,LOCK note;
